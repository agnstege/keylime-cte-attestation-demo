# Copy to /etc/attestation-broker.env on the verifier and chmod 600. Never commit the real file.
CM_URL=https://ciphertrust.home.arpa
CM_USER=broker-svc
CM_PASS=change-me
CM_VERIFY_TLS=false
CTE_POLICY_NAME=cc-demo-policy
CTE_GATED_RULE_ORDER=1
EFFECT_ALLOW=permit,audit,applykey
EFFECT_DENY=deny,audit

KL_VERIFIER=https://127.0.0.1:8881
KL_API=v2.3
KL_TLS_NAME=server
KL_AGENT_UUID=d432fbb3-d2f1-4a97-9ef7-75bd81c00000
KL_CA=/var/lib/keylime/cv_ca/cacert.crt
KL_CERT=/var/lib/keylime/cv_ca/client-cert.crt
KL_KEY=/var/lib/keylime/cv_ca/client-private.pem

POLL_SECONDS=2
WEBHOOK_PORT=8080
